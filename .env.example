# ---------------------------------------------------------------------------
# Neuroclip Studio - environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- HTTP Basic Auth (required) --------------------------------------------
# The app refuses to start if either of these is missing.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- LLM provider keys ------------------------------------------------------
# At least one key is required for the "gemini" provider.
# Extra keys enable automatic rotation on 429 / 503 responses.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- Optional overrides -----------------------------------------------------
# Provider to use. "gemini" for the real API, "mock" for offline runs
# (tests and evals). Overrides `provider` in config.yaml when set.
LLM_PROVIDER=

# Path to the YAML config. Defaults to ./config.yaml next to config.py.
NEUROCLIP_CONFIG=

# Uvicorn bind settings for local runs.
HOST=0.0.0.0
PORT=8000
