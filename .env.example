# ---------------------------------------------------------------------------
# Neuroclip Studio - environment TEMPLATE
#
# This file is committed to the repository and must never contain real values.
# Copy it to `.env` (which is gitignored) and fill that copy in:
#
#     cp .env.example .env
#
# On Vercel there is no .env file: set the same names under
# Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- LLM provider keys (required) -------------------------------------------
# At least one key is required for the "gemini" provider.
# Extra keys enable automatic rotation on 429 / 503 responses.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- Session signing (required when sessions.backend is "stateless") --------
# Serverless hosts have no shared memory, so the pipeline state travels with
# the client as a signed token. This secret signs it; keep it stable, or every
# in-flight session is invalidated.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# --- Optional overrides -----------------------------------------------------
# "gemini" for the real API, "mock" for offline runs (tests and evals).
LLM_PROVIDER=

# "memory" (long-lived process) or "stateless" (serverless).
# Defaults to "stateless" automatically when VERCEL is set.
SESSIONS_BACKEND=

# "static" (writes JPEGs to disk) or "base64" (inline, no filesystem).
# Defaults to "base64" automatically when VERCEL is set.
IMAGES_STORAGE=

# Path to the YAML config. Defaults to ./config.yaml next to config.py.
NEUROCLIP_CONFIG=

# Uvicorn bind settings for local runs.
HOST=0.0.0.0
PORT=8000
